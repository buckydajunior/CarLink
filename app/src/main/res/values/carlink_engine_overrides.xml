<?xml version="1.0" encoding="utf-8"?>
<!--
  Engine strings the driver can see during a session (CarPlay picture, notifications, cluster,
  system settings), reworded for F-150 CarPlay. App resources override library resources of the same
  name; each name is listed in scripts/resource_collisions_allowlist.txt. Keep every format
  placeholder of the engine's original. Strings only on DiPlay's own screens (never shown
  in F-150 CarPlay) are left alone.
-->
<resources>
    <!-- DiPlay: CarPlayHostActivity -->
    <string name="diplay">F-150 CarPlay</string>
    <string name="back_to_diplay">Back to F-150 CarPlay</string>
    <string name="could_not_start_carplay_return_to_diplay_and_check_app_per">Could not start CarPlay. Return to F-150 CarPlay and check app permissions.</string>
    <string name="open_diplay_settings_hint">During CarPlay, swipe down with %1$d fingers to open the CarPlay menu.</string>
    <string name="carplay_settings">CarPlay menu</string>
    <string name="side_panel_full_screen">Full screen</string>
    <string name="setup_error_auth">CarPlay authentication files are missing from this build. Settings › Diagnostics explains what is needed.</string>
    <!-- DiPlay: dashboard map and the accessibility service shown in system settings -->
    <string name="cluster_waiting_for_map">F-150 CarPlay · waiting for the CarPlay map</string>
    <string name="wheel_key_service_label">F-150 CarPlay wheel keys</string>
    <string name="wheel_key_service_description">Lets F-150 CarPlay use the chosen steering-wheel keys to zoom the CarPlay map on the dashboard and to move around CarPlay\'s screen. It only receives key presses and does not read the screen.</string>

</resources>
