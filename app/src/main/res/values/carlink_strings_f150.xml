<resources>
    <string name="carlink_f150_settings">Settings</string>
    <string name="carlink_f150_ready_body">Connect your iPhone to the Linkswell USB data port. CarPlay opens automatically.</string>
    <string name="carlink_f150_access_title">Allow microphone access</string>
    <string name="carlink_f150_access_body">Allow the microphone for Siri and calls. Android may also ask once to allow the wired CarPlay connection.</string>
    <string name="carlink_f150_connecting_body">Keep your iPhone plugged in. Unlock it and accept the CarPlay prompt if asked.</string>
    <string name="carlink_f150_connected_body">Your iPhone is connected by USB.</string>
    <string name="carlink_f150_failed">CarPlay needs attention</string>
    <string name="carlink_f150_failed_body">Unlock your iPhone, check its CarPlay prompt, then try again. If needed, reconnect the USB cable or try another data cable.</string>
    <string name="carlink_f150_auth_missing">This build is missing the CarPlay authentication files. They must be included in a local build before CarPlay can connect.</string>
    <string name="carlink_f150_allow">Allow access</string>
    <string name="carlink_f150_open">Open CarPlay</string>
