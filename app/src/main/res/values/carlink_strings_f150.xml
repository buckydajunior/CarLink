    <string name="carlink_f150_back">Back</string>
    <string name="carlink_f150_icon_size">CarPlay icon size</string>
    <string name="carlink_f150_size_body">Enlarges the apps, text and dock inside CarPlay. Extra large is the starting size for this truck. After changing it, unplug and reconnect your iPhone to apply it. Larger sizes show less content.</string>
    <string name="carlink_f150_size_standard">Standard</string>
